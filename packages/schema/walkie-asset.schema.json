{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mu4ddib/Walkie/packages/schema/walkie-asset.schema.json",
  "title": "Walkie asset v0",
  "description": "Imagen subida a una app (ADR-0004). Un nodo screen la usa con assetId; los bytes se leen en GET /api/assets/{id}.",
  "type": "object",
  "required": ["id", "appId", "contentType", "size", "width", "height"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "appId": { "type": "string", "format": "uuid" },
    "contentType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
    "size": { "type": "integer", "minimum": 1, "maximum": 5242880, "description": "Bytes (hasta 5 MB)" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 }
  }
}
