{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mu4ddib/Walkie/packages/schema/walkie-graph.schema.json",
  "title": "Walkie canvas graph v0",
  "description": "Grafo del lienzo de una feature. Fuente de verdad para web y API.",
  "type": "object",
  "required": ["schemaVersion", "version", "nodes", "edges", "layout"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 0 },
    "version": { "type": "integer", "minimum": 0, "description": "Versión para concurrencia optimista" },
    "nodes": {
      "type": "object",
      "description": "Mapa id -> nodo",
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "object",
      "description": "Mapa id -> conexión",
      "additionalProperties": { "$ref": "#/$defs/edge" }
    },
    "layout": {
      "type": "object",
      "description": "Mapa id de nodo -> posición (separado del contenido)",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "y"],
        "additionalProperties": false,
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "w": { "type": "number" },
          "h": { "type": "number" }
        }
      }
    },
    "tours": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/tour" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "description": "UUID v7 generado en el cliente" },
    "node": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["actor", "screen", "rule", "api", "service", "database", "ref", "portal"]
        },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "assetId": { "type": "string", "description": "Imagen o diseño adjunto (screen)" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 60 },
              "type": { "enum": ["string", "number", "boolean", "date", "enum", "file"] },
              "required": { "type": "boolean" },
              "options": {
                "type": "array",
                "description": "Opciones de un input enum (solo para type enum)",
                "items": { "type": "string", "minLength": 1, "maxLength": 60 }
              },
              "ruleIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
            }
          }
        },
        "expression": { "type": "string", "maxLength": 2000, "description": "Regla en lenguaje natural o pseudo-código (rule)" },
        "http": {
          "type": "object",
          "description": "Contrato (api)",
          "properties": {
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string" },
            "request": { "type": "object" },
            "responses": { "type": "object", "additionalProperties": { "type": "object" } }
          }
        },
        "catalogId": { "type": "string", "description": "Elemento del catálogo de la app (ref)" },
        "targetFeatureId": { "type": "string", "description": "Feature destino (portal)" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["navigation", "request", "response", "uses", "reads", "writes"] },
        "label": { "type": "string", "maxLength": 60 },
        "when": { "type": "string", "maxLength": 60, "description": "Condición, ej. código de respuesta 200 o 404" }
      }
    },
    "tour": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nodeId"],
            "properties": {
              "nodeId": { "$ref": "#/$defs/id" },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
