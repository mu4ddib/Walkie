{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mu4ddib/Walkie/packages/schema/walkie-graph.schema.json",
  "title": "Walkie canvas graph v0",
  "description": "Grafo del lienzo de una feature. Fuente de verdad para web y API.",
  "type": "object",
  "required": ["schemaVersion", "version", "nodes", "edges", "layout"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 0 },
    "version": { "type": "integer", "minimum": 0, "description": "Versión para concurrencia optimista" },
    "nodes": {
      "type": "object",
      "description": "Mapa id -> nodo",
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "object",
      "description": "Mapa id -> conexión",
      "additionalProperties": { "$ref": "#/$defs/edge" }
    },
    "layout": {
      "type": "object",
      "description": "Mapa id de nodo, grupo o nota adhesiva -> posición (separado del contenido)",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "y"],
        "additionalProperties": false,
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "w": { "type": "number" },
          "h": { "type": "number" }
        }
      }
    },
    "tours": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/tour" }
    },
    "groups": {
      "type": "object",
      "description": "Mapa id -> grupo de infraestructura; su caja (x, y, w, h) va en layout con el mismo id",
      "additionalProperties": { "$ref": "#/$defs/group" }
    },
    "stickyNotes": {
      "type": "object",
      "description": "Mapa id -> nota adhesiva (anotación del lienzo, no es un nodo del flujo); su posición va en layout con el mismo id",
      "additionalProperties": { "$ref": "#/$defs/stickyNote" }
    },
    "groupNesting": {
      "const": "explicit",
      "description": "Los grupos guardan su grupo padre en parentId y las notas su grupo en groupId. Sin este campo (lienzos anteriores) la jerarquía se infiere por contención al abrir el lienzo"
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "description": "UUID v7 generado en el cliente" },
    "node": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["actor", "screen", "rule", "api", "service", "database", "ref", "portal"]
        },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "notes": { "type": "string", "maxLength": 4000, "description": "Responsabilidades o notas (actor, pantalla, regla, servicio, portal)" },
        "assetId": { "type": "string", "format": "uuid", "description": "Imagen adjunta (solo screen); id de walkie-asset" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 60 },
              "type": { "enum": ["string", "number", "boolean", "date", "enum", "file"] },
              "required": { "type": "boolean" },
              "options": {
                "type": "array",
                "description": "Opciones de un input enum (solo para type enum)",
                "items": { "type": "string", "minLength": 1, "maxLength": 60 }
              },
              "ruleIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
            }
          }
        },
        "expression": { "type": "string", "maxLength": 2000, "description": "Regla en lenguaje natural o pseudo-código (rule); en una decisión, la condición que se evalúa" },
        "mode": { "enum": ["decision"], "description": "Modo de un nodo rule: ausente documenta una validación o restricción; decision es una bifurcación con salidas (branches)" },
        "branches": {
          "type": "array",
          "maxItems": 24,
          "description": "Salidas de una decisión (solo rule con mode decision); una conexión las referencia con branch",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string", "minLength": 1, "maxLength": 60 }
            }
          }
        },
        "http": { "$ref": "#/$defs/http" },
        "database": { "$ref": "#/$defs/database" },
        "catalogId": { "type": "string", "minLength": 1, "description": "Elemento del catálogo de la app (ref)" },
        "targetFeatureId": { "type": "string", "format": "uuid", "description": "Feature destino de la misma app (portal); en un portal, title guarda su último nombre conocido" },
        "groupId": { "$ref": "#/$defs/id", "description": "Grupo de infraestructura que lo contiene" }
      },
      "if": { "properties": { "type": { "const": "ref" } } },
      "then": { "required": ["catalogId"], "description": "En un ref, title guarda el último título conocido del elemento" }
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["navigation", "request", "response", "event", "uses", "reads", "writes"], "description": "event: mensaje o evento asíncrono (cola, webhook)" },
        "label": { "type": "string", "maxLength": 60 },
        "when": { "type": "string", "maxLength": 60, "description": "Condición que activa la conexión (ej. la de una rama de decisión). El código de una respuesta va en status" },
        "branch": { "$ref": "#/$defs/id", "description": "Salida de la decisión de origen (id en branches del nodo from); su etiqueta se muestra en la conexión" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599, "description": "Código HTTP de una respuesta (kind response)" },
        "replyTo": { "$ref": "#/$defs/id", "description": "Solicitud (conexión request) a la que responde una respuesta" },
        "outcome": { "type": "string", "maxLength": 500, "description": "Qué ocurre después de una respuesta" },
        "request": {
          "type": "object",
          "description": "Datos propios de una solicitud (kind request): endpoint y parámetros de este paso. Sin method ni path, vale el contrato de la API destino",
          "additionalProperties": false,
          "properties": {
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "maxLength": 2000 },
            "params": {
              "type": "array",
              "maxItems": 50,
              "description": "Parámetros o headers con el valor que lleva este paso",
              "items": {
                "type": "object",
                "required": ["name", "in"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "in": { "enum": ["path", "query", "header"] },
                  "value": { "type": "string", "maxLength": 500 }
                }
              }
            }
          }
        },
        "notes": { "type": "string", "maxLength": 2000 },
        "data": {
          "type": "object",
          "description": "Acceso a datos de la interacción",
          "additionalProperties": false,
          "properties": {
            "operation": { "enum": ["read", "write"] },
            "entities": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        },
        "example": { "type": "string", "maxLength": 10000, "description": "Ejemplo de payload de esta interacción; el contrato reutilizable vive en la API" }
      }
    },
    "http": {
      "type": "object",
      "description": "Contrato de una API (nodo api o elemento del catálogo)",
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "maxLength": 2000 },
        "auth": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["none", "bearer", "apiKey", "basic", "oauth2", "mtls", "other"] },
            "description": { "type": "string", "maxLength": 500 }
          }
        },
        "params": {
          "type": "array",
          "maxItems": 100,
          "description": "Parámetros de ruta, query o header",
          "items": {
            "type": "object",
            "required": ["name", "in"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "in": { "enum": ["path", "query", "header"] },
              "type": { "type": "string", "maxLength": 60 },
              "required": { "type": "boolean" },
              "description": { "type": "string", "maxLength": 500 },
              "example": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "request": { "$ref": "#/$defs/body" },
        "responses": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["status"],
            "additionalProperties": false,
            "properties": {
              "status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "description": {
                "type": "string",
                "maxLength": 500,
                "description": "Qué significa; en errores, cuándo ocurre"
              },
              "contentType": { "type": "string", "maxLength": 100 },
              "fields": {
                "type": "array",
                "maxItems": 100,
                "items": { "$ref": "#/$defs/field" }
              },
              "example": { "type": "string", "maxLength": 10000 }
            }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contentType": { "type": "string", "maxLength": 100, "description": "Ej. application/json" },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/field" }
        },
        "example": {
          "type": "string",
          "maxLength": 10000,
          "description": "Ejemplo (JSON u otro) como texto; no se valida contra los campos"
        }
      }
    },
    "field": {
      "type": "object",
      "description": "Campo de un request o response",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "type": "string", "maxLength": 60, "description": "Tipo libre: string, number, uuid, Cliente[]…" },
        "required": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 500 },
        "example": { "type": "string", "maxLength": 500, "description": "Valor de ejemplo" }
      }
    },
    "database": {
      "type": "object",
      "description": "Estructura de una base de datos (nodo database o elemento del catálogo)",
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string", "maxLength": 60, "description": "Ej. PostgreSQL, Oracle, MongoDB" },
        "name": { "type": "string", "maxLength": 120 },
        "schemas": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "tables": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "schema": { "type": "string", "maxLength": 120 },
              "kind": { "enum": ["table", "collection", "view"] },
              "description": { "type": "string", "maxLength": 500 },
              "fields": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "type": { "type": "string", "maxLength": 60 },
                    "key": { "enum": ["primary", "foreign", "unique"] },
                    "nullable": { "type": "boolean" },
                    "description": { "type": "string", "maxLength": 500 }
                  }
                }
              },
              "relations": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "required": ["field", "references"],
                  "additionalProperties": false,
                  "properties": {
                    "field": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "references": { "type": "string", "minLength": 1, "maxLength": 250, "description": "tabla.campo" },
                    "description": { "type": "string", "maxLength": 500 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "group": {
      "type": "object",
      "description": "Grupo de infraestructura del lienzo (frontend, backend…); no es una app ni una feature. Puede estar dentro de otro grupo (parentId)",
      "required": ["id", "title", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["frontend", "backend", "external", "data", "network", "environment", "cloud", "custom"] },
        "collapsed": { "type": "boolean", "description": "Plegado; se conserva aunque un grupo padre se pliegue y despliegue" },
        "parentId": { "$ref": "#/$defs/id", "description": "Grupo que lo contiene (sin ciclos). Plegar el padre oculta este grupo y todo lo suyo" }
      }
    },
    "stickyNote": {
      "type": "object",
      "description": "Nota adhesiva: texto libre sobre el lienzo, sin conexiones",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "maxLength": 1000 },
        "groupId": { "$ref": "#/$defs/id", "description": "Grupo al que pertenece la anotación: se oculta y se mueve con él" }
      }
    },
    "tour": {
      "type": "object",
      "description": "Recorrido guiado por pasos: sobre nodos (modo tour) o sobre conexiones (recorrido de un flujo)",
      "required": ["id", "name", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "kind": {
          "enum": ["guide", "flow"],
          "description": "guide: tour (el guía presenta nodos; solo pasos nodeId). flow: recorrido (reproduce conexiones; pasos edgeId o removedEdge). Ausente en lienzos anteriores: flow si tiene algún paso de conexión"
        },
        "steps": {
          "type": "array",
          "description": "En orden; un paso centra y resalta su nodo, o recorre su conexión (origen, conexión, destino). Una conexión puede repetirse (reintento)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [{ "required": ["nodeId"] }, { "required": ["edgeId"] }, { "required": ["removedEdge"] }],
            "properties": {
              "nodeId": { "$ref": "#/$defs/id", "description": "Nodo que muestra el paso" },
              "edgeId": { "$ref": "#/$defs/id", "description": "Conexión que recorre el paso, en su sentido real (from → to)" },
              "removedEdge": {
                "type": "object",
                "description": "Paso cuya conexión se eliminó: lo que se sabía de ella, para reemplazarla o quitar el paso",
                "required": ["from", "to", "kind"],
                "additionalProperties": false,
                "properties": {
                  "from": { "$ref": "#/$defs/id" },
                  "to": { "$ref": "#/$defs/id" },
                  "kind": { "$ref": "#/$defs/edge/properties/kind" },
                  "label": { "type": "string", "maxLength": 60 }
                }
              },
              "note": { "type": "string", "maxLength": 500, "description": "Lo que el guía cuenta en el paso (descripción del paso)" }
            }
          }
        }
      }
    }
  }
}
