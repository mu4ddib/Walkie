# Copia este archivo a .env (lo hace el devcontainer). Solo valores de desarrollo.
# Valores reales: GitHub Secrets / Codespaces Secrets. Nunca subas .env.

POSTGRES_DB=walkie
POSTGRES_USER=walkie
POSTGRES_PASSWORD=walkie_dev
ConnectionStrings__Walkie=Host=localhost;Port=5432;Database=walkie;Username=walkie;Password=walkie_dev

MINIO_ROOT_USER=walkie
MINIO_ROOT_PASSWORD=walkie_dev_secret
Storage__Endpoint=http://localhost:9000
Storage__Bucket=walkie-assets

# Keycloak local (docker-compose). Usuario de prueba del realm: dev / walkie_dev
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=walkie_dev_admin
Auth__Authority=http://localhost:8080/realms/walkie
Auth__Audience=walkie-api

VITE_OIDC_AUTHORITY=http://localhost:8080/realms/walkie
VITE_OIDC_CLIENT_ID=walkie-web

VITE_API_URL=http://localhost:5080
